{
  "comment": "Content type matching and file kinds (SPEC §5). accept;hint=x requires the hint.",
  "matches": [
    { "accept": "file/*", "offered": "file/image", "expected": true },
    { "accept": "file/*", "offered": "file/image[]", "expected": false },
    { "accept": "file/*[]", "offered": "file/image[]", "expected": true },
    { "accept": "file/*[]", "offered": "file/video", "expected": true },
    { "accept": "file/image[]", "offered": "file/image", "expected": true },
    { "accept": "file/image[]", "offered": "file/pdf[]", "expected": false },
    { "accept": "file/image", "offered": "file/image", "expected": true },
    { "accept": "file/image", "offered": "file/pdf", "expected": false },
    { "accept": "file/any", "offered": "file/pdf", "expected": true },
    { "accept": "file/any[]", "offered": "file/pdf[]", "expected": true },
    { "accept": "text/plain", "offered": "text/url", "expected": true },
    { "accept": "text/plain", "offered": "text/rich", "expected": true },
    { "accept": "text/url", "offered": "text/plain", "expected": false },
    { "accept": "text/*", "offered": "text/rich", "expected": true },
    { "accept": "text/*", "offered": "file/text", "expected": false },
    { "accept": "folder/reference", "offered": "folder/reference", "expected": true },
    { "accept": "folder/reference", "offered": "file/any", "expected": false },
    { "accept": "structured/*", "offered": "structured/color", "expected": true },
    { "accept": "structured/color", "offered": "structured/table", "expected": false },
    { "accept": "*", "offered": "screen/region", "expected": true },
    { "accept": "text/plain;hint=command", "offered": "text/plain", "hints": ["command"], "expected": true },
    { "accept": "text/plain;hint=command", "offered": "text/plain", "hints": [], "expected": false },
    { "accept": "text/plain;hint=command", "offered": "text/url", "hints": ["command"], "expected": true }
  ],
  "kinds": [
    { "path": "/home/u/a.PNG", "kind": "image" },
    { "path": "photo.heic", "kind": "image" },
    { "path": "clip.mkv", "kind": "video" },
    { "path": "song.flac", "kind": "audio" },
