    { "path": "backup.tar.gz", "kind": "archive" },
    { "path": "notes.md", "kind": "text" },
    { "path": "main.rs", "kind": "code" },
    { "path": "app.ts", "kind": "code" },
    { "path": "Inter.woff2", "kind": "font" },
    { "path": "teapot.glb", "kind": "model" },
    { "path": "README", "kind": "any" },
